# Server Configuration
PORT=3000
JWT_SECRET=the_crew_super_secret_cyberpunk_jwt_key_2026

# Database Driver: "sqlite" (default) or "firestore"
DB_DRIVER=sqlite

# SQLite Path (used when DB_DRIVER=sqlite)
DB_PATH=./database.sqlite

# Firebase Firestore Configuration (used when DB_DRIVER=firestore)
# Path to your Firebase service account JSON key file (relative to backend/ or absolute)
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Optional: Firebase project ID (if not defined inside serviceAccountKey.json)
# FIREBASE_PROJECT_ID=the-crew-dev

# Optional: For local development with Firebase Local Emulator Suite:
# FIRESTORE_EMULATOR_HOST=localhost:8080
